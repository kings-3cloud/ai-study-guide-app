# Azure AI Foundry project connection string.
# Found in your Azure AI Foundry project under "Settings" > "Project details".
# Format: <HostName>;<AzureSubscriptionId>;<ResourceGroup>;<ProjectName>
PROJECT_CONNECTION_STRING=your_foundry_project_connection_string_here

# Azure OpenAI model deployment names.
# Must match the deployment names configured in your Azure OpenAI resource.
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_GPT4O_MINI=gpt-4o-mini

# Directory for storing per-user progress data (relative to project root).
PROGRESS_DATA_DIR=data/progress

# Default user ID used when no user context is provided.
DEFAULT_USER_ID=default_user

# URL of the running MCP server (HTTP/SSE transport).
# Start the MCP server with an SSE-compatible runner (e.g. `mcp run --transport sse`).
# For local development this is typically http://localhost:8000/sse.
MCP_SERVER_URL=http://localhost:8000/sse
